<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>アイドルcloud - Lightning Experience</title>
    <style>
        /* ==========================================
           1. グローバル・変数定義
        ========================================== */
        :root {
            --brand-color: #0176D3;
            --brand-hover: #014486;
            --bg-color: #B0C4DF; 
            --surface-color: #FFFFFF;
            --text-main: #181818;
            --text-sub: #444444;
            --text-weak: #747474;
            --border-color: #DDDBDA;
            --header-bg: #FFFFFF;
            --tab-active: #F3F2F2;
            --shadow-sm: 0 2px 2px rgba(0,0,0,0.05);
            --shadow-md: 0 4px 6px rgba(0,0,0,0.1);
            --border-radius: 4px;
            --font-family: "Salesforce Sans", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: var(--font-family); background-color: var(--bg-color); color: var(--text-main); font-size: 13px; line-height: 1.5; height: 100vh; overflow: hidden; display: flex; flex-direction: column; }

        /* ==========================================
           2. グローバルナビゲーション (ヘッダー)
        ========================================== */
        header { background-color: var(--header-bg); border-bottom: 2px solid var(--brand-color); flex-shrink: 0; z-index: 100; box-shadow: var(--shadow-sm); }
        .header-top { display: flex; justify-content: space-between; align-items: center; padding: 8px 20px; border-bottom: 1px solid var(--border-color); }
        .logo { font-size: 1.2rem; font-weight: 700; color: var(--brand-color); display: flex; align-items: center; gap: 8px; }
        .logo span { background: var(--brand-color); color: white; padding: 2px 6px; border-radius: 4px; font-size: 0.8rem; }
        
        .nav-tabs { display: flex; list-style: none; background-color: #FAFAF9; padding-left: 20px; overflow-x: auto;}
        .nav-tabs li { padding: 10px 20px; cursor: pointer; border-bottom: 3px solid transparent; font-weight: bold; color: var(--text-sub); transition: all 0.2s; white-space: nowrap; font-size: 13px;}
        .nav-tabs li:hover { background-color: #F3F2F2; color: var(--brand-color); }
        .nav-tabs li.active { border-bottom-color: var(--brand-color); color: var(--text-main); background-color: var(--surface-color); }

        /* メメインコンテナ */
        main { flex: 1; overflow-y: auto; padding: 20px; }
        .container { max-width: 1400px; margin: 0 auto; }

        /* ==========================================
           3. 共通UIコンポーネント
        ========================================== */
        .card { background: var(--surface-color); border: 1px solid var(--border-color); border-radius: var(--border-radius); box-shadow: var(--shadow-sm); margin-bottom: 16px; }
        
        .btn { padding: 6px 16px; border-radius: var(--border-radius); border: 1px solid var(--border-color); background: white; color: var(--brand-color); cursor: pointer; font-weight: 700; font-size: 13px; transition: background 0.1s; }
        .btn:hover { background: #F3F2F2; }
        .btn-brand { background: var(--brand-color); color: white; border: none; }
        .btn-brand:hover { background: var(--brand-hover); }
        .btn-danger { color: #C23934; }
        .btn-danger:hover { background: #FDE8E9; border-color: #C23934;}

        .input-field { padding: 6px 10px; border: 1px solid var(--border-color); border-radius: var(--border-radius); outline: none; font-size: 13px; }
        .input-field:focus { border-color: var(--brand-color); box-shadow: 0 0 3px rgba(1, 118, 211, 0.4); }

        .action-link { color: var(--brand-color); text-decoration: none; cursor: pointer; }
        .action-link:hover { text-decoration: underline; }

        /* 画面表示制御 */
        .view-section { display: none; }
        .view-section.active { display: block; animation: fadeIn 0.3s; }
        @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }

        /* バッジ・ステータス */
        .badge { padding: 2px 8px; border-radius: 12px; font-size: 11px; font-weight: bold; display: inline-block; }
        .badge-active { background: #E6F4EA; color: #1E8E3E; } 
        .badge-pause { background: #FFF3E0; color: #E65100; } 
        .badge-grad { background: #FCE8E6; color: #D93025; } 

        /* ==========================================
           4. リストビュー (一覧画面)
        ========================================== */
        .list-header { display: flex; justify-content: space-between; align-items: center; padding: 16px 20px; border-bottom: 1px solid var(--border-color); background: #FAFAF9; border-radius: 4px 4px 0 0;}
        .list-header-left h2 { font-size: 1.25rem; font-weight: 700; margin: 0; display: flex; align-items: center; gap: 8px;}
        .list-header-right { display: flex; gap: 8px; align-items: center; }

        table { width: 100%; border-collapse: collapse; font-size: 13px; }
        th, td { padding: 10px 16px; text-align: left; border-bottom: 1px solid var(--border-color); }
        th { background-color: var(--surface-color); color: var(--text-sub); font-weight: 700; cursor: pointer; position: sticky; top: 0; z-index: 10;}
        th:hover { background-color: #F3F2F2; }
        tr:hover td { background-color: #FAFAF9; }

        /* ==========================================
           5. レコード詳細画面 (Lightning風レイアウト)
        ========================================== */
        .detail-page-layout { display: flex; flex-direction: column; gap: 16px; }
        
        .highlights-panel { padding: 16px 20px; display: flex; justify-content: space-between; align-items: flex-start; }
        .hp-left { display: flex; gap: 16px; align-items: center; }
        .entity-icon { width: 48px; height: 48px; border-radius: var(--border-radius); display: flex; justify-content: center; align-items: center; font-size: 24px; color: white; background: var(--brand-color); }
        .hp-title-area .entity-label { font-size: 12px; color: var(--text-sub); margin-bottom: 2px; }
        .hp-title-area h1 { font-size: 20px; margin: 0; font-weight: 700; }
        
        .hp-fields { display: flex; gap: 32px; margin-top: 16px; overflow-x: auto; }
        .hp-field { display: flex; flex-direction: column; min-width: 80px; }
        .hp-field-label { font-size: 11px; color: var(--text-sub); margin-bottom: 4px; white-space: nowrap; }
        .hp-field-value { font-size: 13px; font-weight: 500; white-space: nowrap; }
        
        .hp-actions { display: flex; gap: 8px; }

        .detail-main-split { display: grid; grid-template-columns: 2fr 1fr; gap: 16px; align-items: start; }
        @media (max-width: 900px) {
            .detail-main-split { grid-template-columns: 1fr; }
        }
        
        .detail-tab-header { padding: 12px 20px; border-bottom: 1px solid var(--border-color); font-weight: 700; font-size: 14px;}
        .detail-fields-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px 32px; padding: 20px; }
        .field-item { border-bottom: 1px solid transparent; padding-bottom: 4px; }
        .field-item:hover { border-bottom-color: var(--border-color); }
        .field-label { font-size: 12px; color: var(--text-sub); margin-bottom: 4px; }
        .field-value { font-size: 13px; color: var(--text-main); }

        .related-list-card { margin-bottom: 16px; }
        .rl-header { padding: 12px 16px; border-bottom: 1px solid var(--border-color); background: #FAFAF9; border-radius: 4px 4px 0 0; display: flex; justify-content: space-between; align-items: center;}
        .rl-header h3 { margin: 0; font-size: 13px; }
        .rl-table th, .rl-table td { padding: 8px 16px; font-size: 12px; }

        .breadcrumb { font-size: 12px; color: var(--brand-color); margin-bottom: 12px; cursor: pointer; display: inline-block;}
        .breadcrumb:hover { text-decoration: underline; }

        /* ==========================================
           6. モーダル (新規/編集)
        ========================================== */
        .modal-overlay { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); display: none; justify-content: center; align-items: center; z-index: 1000; }
        .modal { background: white; border-radius: var(--border-radius); width: 600px; max-width: 90%; box-shadow: var(--shadow-md); display: flex; flex-direction: column; max-height: 90vh;}
        .modal-header { padding: 16px 20px; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center; background: #FAFAF9;}
        .modal-body { padding: 20px; overflow-y: auto; display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
        .modal-footer { padding: 16px 20px; border-top: 1px solid var(--border-color); text-align: right; background: #FAFAF9; }
        .form-group { display: flex; flex-direction: column; }
        .form-group.full-width { grid-column: span 2; }
        .form-group label { margin-bottom: 6px; color: var(--text-sub); font-size: 12px; font-weight: 700; }

        /* ==========================================
           7. ダッシュボード・コンポーネント
        ========================================== */
        .dashboard-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 16px; }
        @media (max-width: 768px) {
            .dashboard-grid { grid-template-columns: 1fr 1fr; }
        }
        .kpi-card { padding: 20px; text-align: center; }
        .kpi-value { font-size: 28px; font-weight: 700; color: var(--brand-color); margin-bottom: 4px; }
        .kpi-label { font-size: 12px; color: var(--text-sub); text-transform: uppercase; }
        
        .chart-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px; }
        @media (max-width: 900px) {
            .chart-grid { grid-template-columns: 1fr; }
        }
        .chart-card { min-height: 300px; padding: 20px; }
        .chart-title { font-size: 14px; font-weight: 700; border-bottom: 1px solid var(--border-color); padding-bottom: 10px; margin-bottom: 16px; }

        .bar-scroll { max-height: 350px; overflow-y: auto; padding-right: 4px; }
        .bar-row { display: flex; align-items: center; margin-bottom: 8px; font-size: 12px;}
        .bar-label { width: 140px; text-align: right; margin-right: 10px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;}
        .bar-track { flex: 1; background: #F3F2F2; height: 20px; border-radius: 2px; overflow: hidden; display: flex;}
        .bar-fill { background: var(--brand-color); height: 100%; display: flex; align-items: center; padding-left: 8px; color: white; font-weight: bold; font-size: 11px;}

        .timeline-box { max-height: 350px; overflow-y: auto; padding: 10px; }
        .timeline-item { position: relative; padding-left: 24px; margin-bottom: 16px; border-left: 2px solid var(--border-color); }
        .timeline-item::before { content: ""; position: absolute; left: -6px; top: 2px; width: 10px; height: 10px; background: var(--brand-color); border-radius: 50%; }
        .timeline-date { font-weight: bold; color: var(--brand-color); font-size: 12px; margin-bottom: 2px; }
        .timeline-desc { font-size: 13px; color: var(--text-main); }
    </style>
</head>
<body>

    <!-- ヘッダー (グローバルナビ) -->
    <header>
        <div class="header-top">
            <div class="logo">☁️ アイドルcloud </div>
            <div style="font-size: 12px; color: var(--text-sub);">擬似Salesforce CRM環境 (メモリ保持)</div>
        </div>
        <ul class="nav-tabs" id="global-nav">
            <!-- JSで動的生成されます -->
        </ul>
    </header>

    <main>
        <div class="container">
            <!-- ダッシュボード画面 -->
            <div id="view-dashboard" class="view-section">
                <div class="dashboard-grid" id="dash-kpi"></div>
                <div class="chart-grid">
                    <div class="card chart-card">
                        <div class="chart-title">グループ別 在籍メンバー数 (COUNT集計)</div>
                        <div class="bar-scroll" id="chart-group-members"></div>
                    </div>
                    <div class="card chart-card">
                        <div class="chart-title">兼務・複数所属メンバー一覧 (中間テーブル結合解析)</div>
                        <div class="bar-scroll" id="chart-concurrent"></div>
                    </div>
                </div>
                <div class="chart-grid">
                    <div class="card chart-card" style="grid-column: span 2;">
                        <div class="chart-title">歴史イベント・タイムライン (時系列履歴マスタ)</div>
                        <div class="timeline-box" id="chart-timeline"></div>
                    </div>
                </div>
            </div>

            <!-- リストビュー画面 (一覧) -->
            <div id="view-list" class="view-section active">
                <div class="card">
                    <div class="list-header">
                        <div class="list-header-left">
                            <h2 id="list-title">オブジェクト一覧</h2>
                        </div>
                        <div class="list-header-right">
                            <input type="text" id="search-input" class="input-field" placeholder="このリストを検索...">
                            <select id="filter-select" class="input-field"><option value="all">すべて</option></select>
                            <button class="btn btn-brand" onclick="app.openModal('new')">新規</button>
                        </div>
                    </div>
                    <div style="overflow-x: auto;">
                        <table id="list-table">
                            <thead><tr id="list-thead"></tr></thead>
                            <tbody id="list-tbody"></tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- ★新設: レポート画面 -->
            <div id="view-report" class="view-section">
                <div class="card" style="display: grid; grid-template-columns: 320px 1fr; gap: 24px; align-items: start; padding: 20px;">
                    <!-- 左側: レポート条件設定パネル -->
                    <div style="border-right: 1px solid var(--border-color); padding-right: 24px;">
                        <h2 style="font-size: 15px; font-weight: bold; margin-bottom: 16px; color: var(--brand-color); display: flex; align-items: center; gap: 6px;">📊 レポートビルダー</h2>
                        <div class="form-group" style="margin-bottom: 12px;">
                            <label style="font-weight: bold; font-size: 12px; color: var(--text-sub);">対象オブジェクト</label>
                            <select id="report-object-select" class="input-field" onchange="app.onReportObjectChange()">
                                <option value="idol">アイドル</option>
                                <option value="group">グループ</option>
                                <option value="work">作品</option>
                                <option value="live">ライブ</option>
                                <option value="venue">会場</option>
                                <option value="event">イベント</option>
                            </select>
                        </div>
                        <div class="form-group" style="margin-bottom: 12px;">
                            <label style="font-weight: bold; font-size: 12px; color: var(--text-sub);">検索項目</label>
                            <select id="report-field-select" class="input-field"></select>
                        </div>
                        <div class="form-group" style="margin-bottom: 12px;">
                            <label style="font-weight: bold; font-size: 12px; color: var(--text-sub);">演算子</label>
                            <select id="report-operator-select" class="input-field">
                                <option value="contains">次の文字列を含む</option>
                                <option value="equals">次の値と一致する</option>
                            </select>
                        </div>
                        <div class="form-group" style="margin-bottom: 16px;">
                            <label style="font-weight: bold; font-size: 12px; color: var(--text-sub);">検索値</label>
                            <input type="text" id="report-value-input" class="input-field" placeholder="検索ワードを入力...">
                        </div>
                        <button class="btn btn-brand" onclick="app.runReport()" style="width: 100%;">レポートを実行</button>
                    </div>
                    <!-- 右側: レポート結果表示テーブル -->
                    <div>
                        <div class="list-header" style="background: transparent; padding: 0 0 12px 0; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center;">
                            <h2 id="report-result-title" style="font-size: 15px; margin: 0;">カスタムレポート結果</h2>
                            <div class="badge badge-active" id="report-result-count" style="font-size: 12px;">0 レコード</div>
                        </div>
                        <div style="overflow-x: auto; margin-top: 16px;">
                            <table id="report-result-table">
                                <thead><tr id="report-result-thead"></tr></thead>
                                <tbody id="report-result-tbody"></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 詳細画面 (レコード詳細 ＋ 関連リスト) -->
            <div id="view-detail" class="view-section">
                <div class="breadcrumb" onclick="app.showList()">← <span id="breadcrumb-text">一覧へ戻る</span></div>
                <div class="detail-page-layout">
                    <!-- 上部: コンパクトレイアウト -->
                    <div class="card highlights-panel">
                        <div class="hp-left">
                            <div class="entity-icon" id="detail-icon">📄</div>
                            <div class="hp-title-area">
                                <div class="entity-label" id="detail-obj-name">オブジェクト名</div>
                                <h1 id="detail-title">レコード名</h1>
                                <div class="hp-fields" id="detail-hp-fields"></div>
                            </div>
                        </div>
                        <div class="hp-actions">
                            <button class="btn" onclick="app.openModal('edit', app.currentDetailId)">編集</button>
                            <button class="btn btn-danger" onclick="app.deleteRecord(app.currentDetailId)">削除</button>
                        </div>
                    </div>
                    <!-- 下部: 詳細情報 ＆ 関連リスト分配 -->
                    <div class="detail-main-split">
                        <div class="card">
                            <div class="detail-tab-header">詳細情報</div>
                            <div class="detail-fields-grid" id="detail-info"></div>
                        </div>
                        <div id="related-lists-container"></div>
                    </div>
                </div>
            </div>
        </div>
    </main>

