                <button class="btn" style="border:none; background:transparent;" onclick="app.closeModal()">✕</button>
            </div>
            <div class="modal-body" id="modal-form-content"></div>
            <div class="modal-footer">
                <button class="btn" onclick="app.closeModal()">キャンセル</button>
                <button class="btn btn-brand" onclick="app.saveRecord()">保存</button>
            </div>
        </div>
    </div>

